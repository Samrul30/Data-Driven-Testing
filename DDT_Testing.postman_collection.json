              "});\r",
              "\r",
              "\r",
              "var responsbody = pm.response.json();\r",
              "pm.test(\"Verify that the firstame is showing as expected or not \",function(){\r",
              "    pm.expect(pm.environment.get(\"fName\")).to.eql(responsbody.booking.firstname);\r",
              "});\r",
              "\r",
              "pm.test(\"Verify that the lastname is showing as expected or not \",function(){\r",
              "    pm.expect(pm.environment.get(\"lName\")).to.eql(responsbody.booking.lastname);\r",
              "});\r",
