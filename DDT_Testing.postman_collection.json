              "    pm.expect(pm.response.code).to.eql(200)\r",
              "});\r",
              "\r",
              "pm.test(\"Verify that the response time is showing as expected or not \",function(){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000)\r",
              "});\r",
              "\r",
              "pm.test(\"Verify that the file size is showing as expected or not \",function(){\r",
